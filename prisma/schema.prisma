generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProspectStatus {
  CAPTURED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  DRAFT_CREATED
  SENT
  REPLIED
  INTERESTED
  REFERRAL_SENT
  JOINED
  BOUNCED
  OPTED_OUT
  SUPPRESSED
  NO_EMAIL_FOUND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QualificationStatus {
  QUALIFIED
  LIKELY_QUALIFIED
  NEEDS_REVIEW
  NOT_YET_QUALIFIED
  DO_NOT_CONTACT
}

enum LeadType {
  CREATOR
  BRAND
}

model Prospect {
  id                       String              @id @default(cuid())
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  email                    String?
  normalizedEmail          String?
  leadType                 LeadType            @default(CREATOR)
  displayName              String?
  creatorFirstName         String?
  organizationName         String?
  businessWebsite          String?
  username                 String?
  sourcePlatform           String
  sourceUrl                String?
  emailSourceUrl           String?
  emailSourceType          String?
  campaign                 String?
  screenshotPath           String?
  visibleEmailEvidence     String?
  extractionConfidence     Float?
  profileBio               String?
  creatorCategory          String?
  personalizationHook      String?
  personalizationSourceUrl String?
  personalizationCheckedAt DateTime?
  publicLocation           String?
  locationEvidenceUrl      String?
  timeZone                 String?
  preferredSendHourLocal   Int                 @default(10)
  followerCount            Int?
  followerCountVerified    Boolean             @default(false)
  qualificationStatus      QualificationStatus @default(NEEDS_REVIEW)
  qualificationEvidenceUrl String?
  qualificationCheckedAt   DateTime?
  status                   ProspectStatus      @default(CAPTURED)
  notes                    String?
  doNotContact             Boolean             @default(false)
  gmailDraftId             String?
  referralLinkGeneratedAt  DateTime?
  referralLinkCopiedAt     DateTime?
  referralLinkSentAt       DateTime?
  joinedAt                 DateTime?
  replyReceivedAt          DateTime?
  hardBouncedAt            DateTime?
  optedOutAt               DateTime?
  campaignStartedAt        DateTime?
  campaignCompletedAt      DateTime?
  commissionAmount         Float?
  followUpStage            Int                 @default(0)
  nextFollowUpAt           DateTime?
  lastContactedAt          DateTime?
  suppressionReason        String?
  outreachMessages         OutreachMessage[]
  sourceAssets             SourceAsset[]

  @@index([normalizedEmail])
  @@index([leadType])
  @@index([status])
  @@index([createdAt])
}

model OutreachMessage {
  id             String         @id @default(cuid())
  prospectId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subject        String
  body           String
  htmlBody       String?
  followUpNumber Int            @default(0)
  approvalStatus ApprovalStatus @default(PENDING)
  gmailDraftId   String?
  scheduledFor   DateTime?
  sentAt         DateTime?
  prospect       Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([scheduledFor])
}

model SourceAsset {
  id            String   @id @default(cuid())
  prospectId    String
  filePath      String
  mimeType      String
  extractedText String?
  createdAt     DateTime @default(now())
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model SuppressionEntry {
  id              String   @id @default(cuid())
  normalizedEmail String   @unique
  reason          String
  createdAt       DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model OAuthToken {
  id                    String    @id @default("google")
  provider              String    @unique
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  scope                 String?
  tokenType             String?
  expiryDate            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
