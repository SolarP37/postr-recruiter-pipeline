# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
# Local development uses SQLite. For a Supabase deployment, replace this with
# the transaction-pooler URL in .env.local or the hosting provider's protected
# Preview environment variables. Never paste connection URLs into chat or Git.
DATABASE_URL=file:./dev.db
# Production PostgreSQL only: direct connection used by Prisma migrations.
DIRECT_URL=
ASSET_STORAGE_PROVIDER=local
# Production screenshots require a private Vercel Blob store. Vercel supplies
# these values when the store is connected to the project.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
AUTH_MODE=demo
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
OUTREACH_CONTACT_EMAIL=
OUTREACH_POSTAL_ADDRESS=
CRON_SECRET=
AGENT_MAX_JOBS_PER_RUN=3
AGENT_STALE_LOCK_MINUTES=15
AGENT_QUEUE_LIMIT=100
# Optional per-agent overrides use the normalized agent ID. Examples:
AGENT_CREATOR_QUALIFICATION_MAX_PER_RUN=1
AGENT_CREATOR_QUALIFICATION_QUEUE_LIMIT=25
AGENT_EMAIL_GENERATION_MAX_PER_RUN=1
AGENT_EMAIL_GENERATION_QUEUE_LIMIT=25
AGENT_ANALYTICS_MAX_PER_RUN=1
AGENT_ANALYTICS_QUEUE_LIMIT=25
OPERATIONS_ALERT_WEBHOOK_URL=

# Read-only research adapters. All are disabled until the owner configures the
# provider and explicitly flips the matching enable flag in the target environment.
RESEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
PUBLIC_PAGE_RESEARCH_ENABLED=false
APIFY_DATASET_RESEARCH_ENABLED=false
APIFY_API_TOKEN=
APIFY_DATASET_ID=

# Vision extraction
OPENAI_API_KEY=
VISION_PROVIDER=mock
OPENAI_VISION_MODEL=gpt-5.4-nano
XAI_API_KEY=

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
TOKEN_ENCRYPTION_KEY=
# Gmail address or plus-address used only for incoming phone screenshots.
# Example: yourname+postr-capture@gmail.com
INBOUND_CAPTURE_EMAIL=

# Postr
OUTREACH_SENDING_MODE=draft_only

# Authentication
AUTH_SECRET=
