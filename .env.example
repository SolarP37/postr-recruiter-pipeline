# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local development uses SQLite. For a Supabase deployment, replace this with
# the transaction-pooler URL in .env.local or the hosting provider's protected
# Preview environment variables. Never paste connection URLs into chat or Git.
DATABASE_URL=file:./dev.db
# Production PostgreSQL only: direct connection used by Prisma migrations.
DIRECT_URL=
AUTH_MODE=demo
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Vision extraction
OPENAI_API_KEY=
VISION_PROVIDER=mock
OPENAI_VISION_MODEL=gpt-5.4-nano
XAI_API_KEY=

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
TOKEN_ENCRYPTION_KEY=

# Postr
POSTR_RECRUITER_LINK=

# Authentication
AUTH_SECRET=
