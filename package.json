{
  "name": "postr-recruiter-pipeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:postgres": "npm run db:postgres:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qr:crop": "node scripts/crop-official-qr.mjs",
    "qr:verify": "node scripts/verify-recruiter-qr.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:schemas:check": "node scripts/check-prisma-schema-parity.mjs",
    "db:postgres:validate": "prisma validate --schema prisma/postgresql/schema.prisma",
    "db:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:migrate:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "auth:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "next": "16.2.10",
    "openai": "^6.48.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsqr": "^1.4.0",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
